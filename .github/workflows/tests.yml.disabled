name: Tests

on:
  - pull_request
  - workflow_dispatch

permissions:
  contents: write
  pull-requests: write

concurrency:
  group: ${{ github.ref }}-${{ github.workflow }}-${{ github.event_name }}-${{ github.event_name != 'pull_request' && github.sha || '' }}
  cancel-in-progress: true

jobs:
  tests:
    strategy:
      matrix:
        os:
          - ubuntu-latest
          - macos-latest

    runs-on: ${{ matrix.os }}
    timeout-minutes: 3

    steps:
      - uses: actions/checkout@v5

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.13"
          cache: pip

      - name: Install requirements
        run: python -m pip install -r requirements-tests.txt

      - name: Install Kindling (GNU/Linux)
        if: ${{ matrix.os == 'ubuntu-latest' }}
        run: |
          mkdir -p ~/.local/bin
          wget https://github.com/ciscoriordan/kindling/releases/download/0.29.3/kindling-cli-linux -O ~/.local/bin/kindling
          chmod a+x ~/.local/bin/kindling

      - name: Install Kindling (macOS)
        if: ${{ matrix.os == 'macos-latest' }}
        run: |
          mkdir -p ~/.local/bin
          wget https://github.com/ciscoriordan/kindling/releases/download/v0.29.3/kindling-cli-mac-apple-silicon -O ~/.local/bin/kindling
          chmod a+x ~/.local/bin/kindling

      - name: Unit tests
        run: python -Wd -m pytest tests --doctest-modules wikidict

  automerge:
    runs-on: ubuntu-latest
    needs: [tests]
    if: ${{ github.actor == 'dependabot[bot]' }}
    steps:
      - name: Automerge
        run: gh pr merge --auto --rebase "$PR_URL"
        env:
          PR_URL: ${{github.event.pull_request.html_url}}
          GITHUB_TOKEN: ${{secrets.GITHUB_TOKEN}}
